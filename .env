AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=not_a_real_fernet_key_change_me
AIRFLOW__CORE__LOAD_EXAMPLES=False

AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

POSTGRES_USER=airflow_user
POSTGRES_PASSWORD=airflow_password
POSTGRES_DB=airflow

AIRFLOW__WEBSERVER__SECRET_KEY=not_a_real_secret_key_change_me
AIRFLOW__WEBSERVER__RBAC=True

