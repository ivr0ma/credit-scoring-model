POSTGRES_DB=lakefs
POSTGRES_USER=lakefs
POSTGRES_PASSWORD=changeme123
POSTGRES_HOST=db
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=lakefs-artifacts
MINIO_HOST=minio
MINIO_PORT=9000

LAKEFS_DATABASE_CONNECTION_STRING=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

LAKEFS_BLOCKSTORE_TYPE=s3
LAKEFS_BLOCKSTORE_S3_ENDPOINT=http://minio:9000
LAKEFS_BLOCKSTORE_S3_REGION=us-east-1
LAKEFS_BLOCKSTORE_S3_CREDENTIALS_ACCESS_KEY_ID=fake-access-key
LAKEFS_BLOCKSTORE_S3_CREDENTIALS_SECRET_ACCESS_KEY=fake-secret-key
LAKEFS_BLOCKSTORE_S3_FORCE_PATH_STYLE=true

LAKEFS_AUTH_ENCRYPTION_SECRET_KEY=please-change-this-32-char-secret
LAKEFS_LOGGING_LEVEL=INFO
LAKEFS_LISTEN_ADDRESS=0.0.0.0:8000

